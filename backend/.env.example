PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vrr-events
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VRR Events <no-reply@vrr-events.local>
